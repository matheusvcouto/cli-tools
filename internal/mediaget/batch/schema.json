{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "media-get batch manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "defaults": {
      "$ref": "#/$defs/options"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "onError": {
          "enum": [
            "continue",
            "stop"
          ]
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "referer": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "options": {
            "$ref": "#/$defs/options"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    }
  },
  "$defs": {
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "referer": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "outputDir": {
          "type": "string"
        },
        "subtitleLang": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "video",
            "audio",
            "subtitle"
          ]
        },
        "quality": {
          "enum": [
            "best",
            "2160",
            "1080",
            "720",
            "480",
            "360"
          ]
        },
        "videoFormat": {
          "enum": [
            "auto",
            "mp4"
          ]
        },
        "subtitleFormat": {
          "enum": [
            "srt",
            "txt"
          ]
        },
        "autoSubs": {
          "type": "boolean"
        },
        "concurrentFragments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    }
  }
}
