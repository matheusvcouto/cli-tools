{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "videos"
  ],
  "properties": {
    "pageUrl": {
      "type": "string"
    },
    "exportedAt": {
      "type": "string"
    },
    "videos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "referer": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "refererProvenance": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
