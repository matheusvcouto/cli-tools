  "root": {
    "id": "repozip.root",
    "name": "repo-zip",
    "args": [
      {
        "id": "repozip.source",
        "name": "source",
        "summary": "repository directory",
        "type": "directory",
        "hint": "directory",
        "max": 1
      }
    ],
    "flags": [
      {
        "id": "repozip.force",
        "long": "force",
        "summary": "atomically replace an existing regular output file",
        "short": "f",
        "type": "bool",
        "action": "switch"
      },
      {
        "id": "repozip.git",
        "long": "git",
        "summary": "include restorable Git bundle and Git state in automatic name",
        "type": "bool",
        "action": "switch"
      },
      {
        "id": "repozip.name",
        "long": "name",
        "summary": "base name for automatic output",
        "short": "n",
        "type": "string",
        "action": "set"
      },
      {
        "id": "repozip.output",
        "long": "output",
        "summary": "exact output path (.zip)",
        "short": "o",
        "type": "file",
        "hint": "file",
        "action": "set"
      },
      {
        "id": "repozip.suffix",
        "long": "suffix",
        "summary": "append suffix to automatic name",
        "short": "s",
        "type": "string",
        "action": "set"
      }
    ],
    "constraints": [
      {
        "kind": "conflicts",
        "ids": [
          "repozip.output",
          "repozip.name"
        ],
        "message": "use --output or --name, not both"
      },
      {
        "kind": "conflicts",
        "ids": [
          "repozip.output",
          "repozip.suffix"
        ],
        "message": "--output defines the exact filename; include any suffix in that path"
      }
    ],
