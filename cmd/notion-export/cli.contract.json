{
  "contract_version": 1,
  "schema_version": 1,
  "completion_protocol": 1,
  "app_id": "notion-export",
  "name": "notion-export",
  "root": {
    "id": "notionexport.root",
    "name": "notion-export",
    "examples": [
      "notion-export https://example.notion.site/Page-0123456789abcdef0123456789abcdef",
      "notion-export 0123456789abcdef0123456789abcdef --yes --format html",
      "notion-export --from-json exports/page/page.json --out rebuilt"
    ],
    "args": [
      {
        "id": "notionexport.source",
        "name": "source",
        "summary": "public page URL or page ID",
        "type": "string",
        "max": 1
      }
    ],
    "flags": [
      {
        "id": "notionexport.attachments",
        "long": "attachments",
        "summary": "ask, yes or no for attachments (default: ask)",
        "type": "enum",
        "hint": "enum",
        "action": "set",
        "choices": [
          {
            "Value": "ask",
            "Description": "perguntar quando houver"
          },
          {
            "Value": "yes",
            "Description": "baixar"
          },
          {
            "Value": "no",
            "Description": "manter remoto"
          }
        ]
      },
      {
        "id": "notionexport.audio",
        "long": "audio",
        "summary": "ask, yes or no for audio (default: ask)",
        "type": "enum",
        "hint": "enum",
        "action": "set",
        "choices": [
          {
            "Value": "ask",
            "Description": "perguntar quando houver"
          },
          {
            "Value": "yes",
            "Description": "baixar"
          },
          {
            "Value": "no",
            "Description": "manter remoto"
          }
        ]
      },
      {
        "id": "notionexport.concurrency",
        "long": "concurrency",
        "summary": "parallel requests/downloads (1-64)",
        "type": "count",
        "action": "set",
        "defaults": [
          "6"
        ]
      },
      {
        "id": "notionexport.force",
        "long": "force",
        "summary": "replace a previous export of the same page (validated by its manifest)",
        "short": "f",
        "type": "bool",
        "action": "switch"
      },
      {
        "id": "notionexport.format",
        "long": "format",
        "summary": "outputs to render",
        "type": "enum",
        "hint": "enum",
        "action": "set",
        "defaults": [
          "both"
        ],
        "choices": [
          {
            "Value": "both",
            "Description": "Markdown and HTML"
          },
          {
            "Value": "md",
            "Description": "Markdown only"
          },
          {
            "Value": "html",
            "Description": "HTML only"
          }
        ]
      },
      {
        "id": "notionexport.from-json",
        "long": "from-json",
        "summary": "reprocess a saved page.json recordMap",
        "type": "file",
        "hint": "file",
        "action": "set"
      },
      {
        "id": "notionexport.images",
        "long": "images",
        "summary": "ask, yes or no for images (default: ask)",
        "type": "enum",
        "hint": "enum",
        "action": "set",
        "choices": [
          {
            "Value": "ask",
            "Description": "perguntar quando houver"
          },
          {
            "Value": "yes",
            "Description": "baixar"
          },
          {
            "Value": "no",
            "Description": "manter remoto"
          }
        ]
      },
      {
        "id": "notionexport.no-size-probe",
        "long": "no-size-probe",
        "summary": "skip the 1-byte range requests that estimate asset sizes",
        "type": "bool",
        "action": "switch"
      },
      {
        "id": "notionexport.out",
        "long": "out",
        "summary": "base output directory (created when needed)",
        "short": "o",
        "type": "directory",
        "hint": "directory",
        "action": "set",
        "defaults": [
          "exports"
        ]
      },
      {
        "id": "notionexport.pdfs",
        "long": "pdfs",
        "summary": "ask, yes or no for pdfs (default: ask)",
        "type": "enum",
        "hint": "enum",
        "action": "set",
        "choices": [
          {
            "Value": "ask",
            "Description": "perguntar quando houver"
          },
          {
            "Value": "yes",
            "Description": "baixar"
          },
          {
            "Value": "no",
            "Description": "manter remoto"
          }
        ]
      },
      {
        "id": "notionexport.videos",
        "long": "videos",
        "summary": "ask, yes or no for videos (default: ask)",
        "type": "enum",
        "hint": "enum",
        "action": "set",
        "choices": [
          {
            "Value": "ask",
            "Description": "perguntar quando houver"
          },
          {
            "Value": "yes",
            "Description": "baixar"
          },
          {
            "Value": "no",
            "Description": "manter remoto"
          }
        ]
      },
      {
        "id": "notionexport.yes",
        "long": "yes",
        "summary": "download every asset type without prompting (per-type flags still win)",
        "short": "y",
        "type": "bool",
        "action": "switch"
      }
    ],
    "constraints": [
      {
        "kind": "exactly_one",
        "ids": [
          "notionexport.source",
          "notionexport.from-json"
        ],
        "message": "informe uma URL/page ID pública ou --from-json \u003cpage.json\u003e, não os dois"
      }
    ],
    "option_policy": "interspersed",
    "commands": [
      {
        "id": "cli.builtin.completion",
        "name": "completion",
        "summary": "manage generated shell completions",
        "option_policy": "interspersed",
        "commands": [
          {
            "id": "cli.builtin.completion.doctor",
            "name": "doctor",
            "summary": "diagnose completion installation",
            "args": [
              {
                "id": "cli.builtin.completion.doctor.shell",
                "name": "shell",
                "summary": "target shell; omit to check all",
                "type": "enum",
                "hint": "enum",
                "max": 1,
                "choices": [
                  {
                    "Value": "fish",
                    "Description": ""
                  },
                  {
                    "Value": "nushell",
                    "Description": ""
                  },
                  {
                    "Value": "bash",
                    "Description": ""
                  },
                  {
                    "Value": "zsh",
                    "Description": ""
                  },
                  {
                    "Value": "powershell",
                    "Description": ""
                  }
                ]
              }
            ],
            "option_policy": "interspersed"
          },
          {
            "id": "cli.builtin.completion.generate",
            "name": "generate",
            "summary": "generate completion code",
            "args": [
              {
                "id": "cli.builtin.completion.generate.shell",
                "name": "shell",
                "summary": "target shell",
                "type": "enum",
                "hint": "enum",
                "required": true,
                "min": 1,
                "max": 1,
                "choices": [
                  {
                    "Value": "fish",
                    "Description": ""
                  },
                  {
                    "Value": "nushell",
                    "Description": ""
                  },
                  {
                    "Value": "bash",
                    "Description": ""
                  },
                  {
                    "Value": "zsh",
                    "Description": ""
                  },
                  {
                    "Value": "powershell",
                    "Description": ""
                  }
                ]
              }
            ],
            "option_policy": "interspersed"
          },
          {
            "id": "cli.builtin.completion.install",
            "name": "install",
            "summary": "install generated completion",
            "args": [
              {
                "id": "cli.builtin.completion.install.shell",
                "name": "shell",
                "summary": "target shell; omit to install all",
                "type": "enum",
                "hint": "enum",
                "max": 1,
                "choices": [
                  {
                    "Value": "fish",
                    "Description": ""
                  },
                  {
                    "Value": "nushell",
                    "Description": ""
                  },
                  {
                    "Value": "bash",
                    "Description": ""
                  },
                  {
                    "Value": "zsh",
                    "Description": ""
                  },
                  {
                    "Value": "powershell",
                    "Description": ""
                  }
                ]
              }
            ],
            "option_policy": "interspersed"
          },
          {
            "id": "cli.builtin.completion.list",
            "name": "list",
            "summary": "list supported shells",
            "option_policy": "interspersed"
          },
          {
            "id": "cli.builtin.completion.status",
            "name": "status",
            "summary": "show completion installation status",
            "args": [
              {
                "id": "cli.builtin.completion.status.shell",
                "name": "shell",
                "summary": "target shell; omit to show all",
                "type": "enum",
                "hint": "enum",
                "max": 1,
                "choices": [
                  {
                    "Value": "fish",
                    "Description": ""
                  },
                  {
                    "Value": "nushell",
                    "Description": ""
                  },
                  {
                    "Value": "bash",
                    "Description": ""
                  },
                  {
                    "Value": "zsh",
                    "Description": ""
                  },
                  {
                    "Value": "powershell",
                    "Description": ""
                  }
                ]
              }
            ],
            "option_policy": "interspersed"
          },
          {
            "id": "cli.builtin.completion.uninstall",
            "name": "uninstall",
            "summary": "uninstall generated completion",
            "args": [
              {
                "id": "cli.builtin.completion.uninstall.shell",
                "name": "shell",
                "summary": "target shell; omit to uninstall all",
                "type": "enum",
                "hint": "enum",
                "max": 1,
                "choices": [
                  {
                    "Value": "fish",
                    "Description": ""
                  },
                  {
                    "Value": "nushell",
                    "Description": ""
                  },
                  {
                    "Value": "bash",
                    "Description": ""
                  },
                  {
                    "Value": "zsh",
                    "Description": ""
                  },
                  {
                    "Value": "powershell",
                    "Description": ""
                  }
                ]
              }
            ],
            "option_policy": "interspersed"
          }
        ]
      },
      {
        "id": "cli.builtin.help",
        "name": "help",
        "summary": "show help for a command",
        "args": [
          {
            "id": "cli.builtin.help.path",
            "name": "command",
            "type": "string",
            "mode": "variadic",
            "max": -1
          }
        ],
        "option_policy": "interspersed"
      },
      {
        "id": "cli.builtin.version",
        "name": "version",
        "summary": "show product and build version information",
        "flags": [
          {
            "id": "cli.builtin.version.json",
            "long": "json",
            "summary": "emit structured version information",
            "type": "bool",
            "action": "switch"
          }
        ],
        "outputs": [
          "human",
          "json"
        ],
        "option_policy": "interspersed"
      }
    ]
  }
}
